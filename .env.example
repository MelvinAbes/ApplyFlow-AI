# Backend
DATABASE_URL=sqlite:///../data/job_assistant.db
APP_BASE_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:5173
AUTO_SUBMIT=false
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=0
LOG_LEVEL=INFO

# AI (Codex + ChatGPT sign-in is the default; deterministic features work disconnected)
AI_PROVIDER=codex
CODEX_MODEL=
CODEX_EFFORT=low

# Optional Responses API fallback (set AI_PROVIDER=openai or auto)
OPENAI_API_KEY=
OPENAI_MODEL=

# Frontend
VITE_API_URL=http://127.0.0.1:8000/api
